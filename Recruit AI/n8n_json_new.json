    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"parameters\": {\n    \"mode\": \"raw\",\n    \"jsonOutput\": \"{\\n  \\\"resume_text\\\": \\\"={{ $json.data }}\\\",\\n  \\\"job_description\\\": \\\"={{ $json.jd }}\\\"\\n}\\n\",\n    \"options\": {}\n  },\n  \"type\": \"n8n-nodes-base.set\",\n  \"typeVersion\": 3.4,\n  \"position\": [\n    816,\n    1088\n  ],\n  \"id\": \"25f4ba3d-0b45-4d87-8538-b90055809611\",\n  \"name\": \"Edit Fields\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        816,
        1088
      ],
      "id": "25f4ba3d-0b45-4d87-8538-b90055809611",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet data = {};\ntry {\n  // 1. Get the string from the 'output' field\n  // 2. Strip away the markdown backticks (```json and ```)\n  // 3. Parse the remaining string into a real JSON object\n  const cleanString = input.output.replace(/```json|```/g, \"\").trim();\n  data = JSON.parse(cleanString);\n} catch (e) {\n  // Fallback if parsing fails\n  data = {};\n}\n\nconst clean = (val) => (val === \"N/A\" || !val) ? \"\" : val;\n\nreturn [\n  {\n    json: {\n      name: clean(data.name) || \"Unknown Candidate\",\n      email: clean(data.email),\n      city: clean(data.city),\n      phone: clean(data.phone)\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        1088
      ],
      "id": "c8b6d99a-8633-4537-aec5-4625e04b6134",
      "name": "Normalize Candidate Info"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nlet aiData = {};\ntry {\n  if (item.output && typeof item.output === 'string') {\n    const cleanString = item.output.replace(/```json|```/g, \"\").trim();\n    aiData = JSON.parse(cleanString);\n  }\n} catch (e) {\n  aiData = {};\n}\n\n// 1. Force the score into a Number\nlet finalScore = Number(aiData.match_score || item.score || 0);\n\n// 2. Define scoring logic (Customizable for Recruit-AI)\nlet finalStatus = aiData.recommended_action || item.status || \"Needs Further Review\";\n\n// Rule: If score is 75 or above, ensure status is \"Interview\"\nif (finalScore >= 75) {\n  finalStatus = \"Interview\";\n} else if (finalScore < 40) {\n  finalStatus = \"Reject\";\n}\n\nreturn [\n  {\n    json: {\n      name: item.name || \"Unknown Candidate\",\n      email: item.email || \"\",\n      score: finalScore,\n      status: finalStatus\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
